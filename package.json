{
  "name": "entry-ticketing",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "idl": "anchor idl build -p entry --out idls/entry.json --out-ts idls/entry.ts --skip-lint",
    "dev:organizer": "pnpm --filter @entry/organizer-web dev",
    "dev:wallet": "pnpm --filter @entry/wallet-web dev",
    "dev:gate": "pnpm --filter @entry/gate-pwa dev",
    "dev:blinks": "pnpm --filter @entry/blinks-api dev"
  },
  "devDependencies": { "typescript": "^5.8.3", "vitest": "^3.2.4" }
}
